# 本地数据库配置。复制成 .env.db 后按需改动：
#
#   cp .env.db.example .env.db
#
# .env.db 已被 gitignore，不会被提交。没有这个文件时全部用默认值，也能直接起。

# 端口。默认 55432，避开本机常见的 5432。
DSH_DB_PORT=55432

# 库名 / 用户 / 密码。默认值只适合本地开发——正式部署请改掉。
DSH_DB_NAME=cs_agent
DSH_DB_USER=cs_agent
DSH_DB_PASSWORD=cs_agent_dev

# 镜像。本机已有所需版本时指过去，省一次拉取。
# DSH_DB_IMAGE=postgres:16-alpine

# 跑测试和迁移时打开数据库。业务代码只在 DSH_DB=1 时才连库。
DSH_DB=1
