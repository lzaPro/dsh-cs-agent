{
  "name": "@local/dsh-ops-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Operations agent: incident dispatcher, read-only cluster/log/metric tools, internal runbooks, and an admin panel",
  "exports": {
    ".": "./index.js",
    "./dispatcher": "./dispatcher.js",
    "./cluster": "./cluster.js",
    "./scope": "./scope.js",
    "./promql": "./promql.js",
    "./metrics": "./metrics.js",
    "./task-tools": "./task-tools.js",
    "./panel": "./panel.js",
    "./paths": "./paths.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "MIT",
  "files": [
    "index.js",
    "dispatcher.js",
    "cluster.js",
    "scope.js",
    "promql.js",
    "metrics.js",
    "task-tools.js",
    "panel.js",
    "paths.js",
    "client.js",
    "skills",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "LICENSE"
  ],
  "//files": "目录形式的 files 条目会整目录打包，包根的 .npmignore 对 files[] 不起作用——只有子目录里的 .npmignore 才能排除其中的凭证。列目录前先确认该目录有 .npmignore。"
}
